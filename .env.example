# Copie para .env.local e ajuste. Nunca versione segredos reais.
DATABASE_URL=postgres://afiliados:afiliados_dev@localhost:5432/afiliados_dev

# Segredo para HMAC de IPs e tokens (mínimo 32 caracteres). Gere com: openssl rand -base64 48
AUTH_SECRET=troque-este-valor-por-um-segredo-aleatorio-com-48-bytes

# URL pública da aplicação (usada em links de e-mail)
APP_URL=http://localhost:3000

# Envio de e-mail: console (dev, imprime no terminal) | resend (produção). Ver docs/12.
MAIL_DRIVER=console
MAIL_FROM="Afiliados Moda <nao-responda@seu-dominio>"
RESEND_API_KEY=

# Chave de 32 bytes em base64 para criptografar CPF e chave PIX (obrigatória em produção):
#   openssl rand -base64 32
PII_ENCRYPTION_KEY=

# Verificação em duas etapas (app autenticador) obrigatória para operadoras e administradoras.
# Em produção é sempre obrigatória (não pode ser "false"). Em homologação, recomenda-se "true".
REQUIRE_STAFF_MFA=false

# Login com Google (opcional). Criar em Google Cloud → APIs e serviços → Credenciais → "ID do cliente OAuth"
# (aplicativo da Web), com URI de redirecionamento autorizado: <APP_URL>/api/auth/google/callback. Ver docs/12 §7.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Credenciais VTEX: os NOMES destas variáveis são exibidos no painel de Integrações (ex.: VTEX_SUNTIME_APP_KEY).
# VTEX_<MARCA>_APP_KEY=
# VTEX_<MARCA>_APP_TOKEN=

# Ambiente lógico: development | staging | production. Em production, demonstração é bloqueada.
APP_ENV=development

# Senha das contas FICTÍCIAS criadas por `pnpm db:seed` (somente desenvolvimento/homologação)
SEED_PASSWORD=troque-esta-senha-local

# Hosts das imagens de produtos das marcas (CDN), separados por vírgula. A confirmar com a Suntime.
IMAGE_REMOTE_HOSTS=

# Segredo do agendador de importações (mínimo 32 caracteres). Enviado como "Authorization: Bearer <valor>".
CRON_SECRET=
